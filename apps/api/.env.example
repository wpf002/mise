NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://mise:mise@localhost:5432/mise
# Comma-separated origins allowed to call the API (Expo web dev, admin tools). Native apps don't send Origin.
CORS_ORIGINS=http://localhost:8081
# openssl rand -base64 48
JWT_SECRET=replace-with-48-plus-random-bytes
# Flint (AI seam layer). Server-side only.
FLINT_BASE_URL=
FLINT_API_KEY=
FLINT_MODEL=chef
# S3-compatible bucket for dish and fridge photos (Cloudflare R2 or Railway bucket)
S3_ENDPOINT=
S3_BUCKET=mise-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=8
